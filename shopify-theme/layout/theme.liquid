<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{{ page_title | default: shop.name }} ★ MySAT'S BLOG</title>
  <meta name="description" content="Le blog officiel de SATINE : chanteuse, productrice. Merch, tournée, clip et secrets.">
  {% if template == 'page.secret' %}<meta name="robots" content="noindex">{% endif %}
  <link rel="icon" type="image/png" href="{{ 'favicon-64.png' | asset_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Audiowide&family=VT323&family=Comic+Relief:wght@400;700&family=Comic+Neue:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
  {{ 'main.css' | asset_url | stylesheet_tag }}
  {{ 'intro.css' | asset_url | stylesheet_tag }}
  <script>
    /* base CDN des assets du thème, consommée par ASSET() dans les JS */
    window.__ASSET_BASE = "{{ 'main.css' | asset_url | split: 'main.css' | first }}";

    /* apparition des sections au scroll : la classe doit être posée avant le
       premier paint, sinon la page s'affiche entière puis se cache. Sans JS
       elle n'est jamais posée et tout reste visible (voir initReveal). */
    document.documentElement.className += ' rv-ready';

    /* PORTE D'ENTRÉE (voir intro.html) — doit rester en tête du <head> et
       synchrone : au retour de la porte, la classe .intro-reveal pose la
       bouche fermée AVANT le premier paint, sinon on verrait le site.
       Sans sessionStorage (navigation privée stricte) on sert le site
       directement : jamais de boucle de redirection. */
  </script>
  {% if template == 'index' %}{% unless request.design_mode %}
  <script>
    /* PORTE D'ENTRÉE (voir templates/page.entrer.liquid). request.design_mode :
       jamais dans l'éditeur de thème, sinon le marchand serait redirigé à
       chaque aperçu. */
    (function () {
      /* URL de la porte, à changer d'un seul endroit lors du passage en thème
         Shopify : ce script devient un snippet du <head> de theme.liquid et
         GATE_URL devient '/pages/entrer'. */
      var GATE_URL = '/pages/entrer';

      /* La porte ne se joue qu'UNE fois par visiteur : le passage est
         mémorisé en localStorage (persistant, survit à la fermeture du
         navigateur). S'y ajoutent : la navigation interne (retour de
         secret.html, bouton Précédent), qui n'est pas une arrivée sur le
         site, et ?nointro=1. */
      function internalNav() {
        var e = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
        var type = e ? e.type
          : (performance.navigation && performance.navigation.type === 1 ? 'reload' : 'navigate');
        if (type === 'reload') return false;
        if (type === 'back_forward') return true;
        return document.referrer.indexOf(location.origin + '/') === 0;
      }

      var s;
      try { s = window.sessionStorage; } catch (e) { return; }
      if (!s) return;
      try {
        /* jeton à usage unique posé par intro.html juste avant de naviguer */
        if (s.getItem('satine-reveal')) {
          s.removeItem('satine-reveal');
          document.documentElement.className += ' intro-reveal';
          return;
        }
        if (/[?&]nointro\b/.test(location.search)) return;
        if (internalNav()) return;
        try { if (window.localStorage && localStorage.getItem('satine-entered')) return; } catch (e) { return; }
        location.replace(GATE_URL);
      } catch (e) { /* quota/refus : on laisse passer */ }
    })();
  </script>
  {% endunless %}{% endif %}
  <script>
    /* LA BOUTIQUE, lue dans Shopify au rendu — titres, prix, variantes et
       disponibilité. shared.js s'en sert s'il la trouve, et retombe sur ses
       valeurs de démonstration sinon (c'est ce qui permet au site statique
       de continuer à tourner hors Shopify).
       `| json` fait tout l'échappement : ne jamais concaténer à la main une
       chaîne venant du back-office, une apostrophe dans un titre suffirait
       à casser le script. */
    {%- assign slot_ids = 'barrettes,poster' | split: ',' -%}
    {%- assign slot_handles = 'barrettes,poster' | split: ',' -%}
    window.SATINE_SHOP = { products: {
    {%- assign sep = '' -%}
    {%- for h in slot_handles -%}
      {%- assign p = all_products[h] -%}
      {%- if p.id -%}
        {{ sep }}{{ slot_ids[forloop.index0] | json }}: {
          "handle": {{ p.handle | json }},
          "title": {{ p.title | json }},
          "description": {{ p.description | strip_html | strip | json }},
          "available": {{ p.available | json }},
          "variants": [
          {%- assign vsep = '' -%}
          {%- for v in p.variants -%}
            {{ vsep }}{
              "id": {{ v.id }},
              "title": {{ v.title | json }},
              "price": {{ v.price }},
              "available": {{ v.available | json }}
            }
            {%- assign vsep = ',' -%}
          {%- endfor -%}
          ]
        }
        {%- assign sep = ',' -%}
      {%- endif -%}
    {%- endfor -%}
    } };
    /* le panier courant, pour que le tiroir soit juste dès le premier paint */
    window.SATINE_CART = {{ cart | json }};
  </script>
  <script src="{{ 'shared.js' | asset_url }}" defer></script>
  <script src="{{ 'intro.js' | asset_url }}" defer></script>
  {% if template == 'page.secret' %}
  <script src="{{ 'player-cd.js' | asset_url }}" defer></script>
  <script src="{{ 'secret.js' | asset_url }}" defer></script>
  {% endif %}
  {{ content_for_header }}
</head>
<body data-page="{% if template == 'page.secret' %}secret{% else %}home{% endif %}">
{{ content_for_layout }}
</body>
</html>
