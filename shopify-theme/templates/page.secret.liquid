{% comment %} Page secrète (mot de passe : voir js/secret.js) — créer une Page de handle « secret » avec ce template {% endcomment %}
<div id="page-main">

  <!-- ============ PORTE VERROUILLÉE ============ -->
  <div class="secret-gate" id="secret-gate">
    <span class="door">🚪</span>
    <h1 class="page-title">PAGE SECRÈTE</h1>
    <p class="page-sub">il te faut le code. il est quelque part sur ce site…<br>regarde bien les pubs 👀</p>
    <div class="code-row">
      <input id="code-input" maxlength="12" placeholder="······" autocomplete="off" spellcheck="false">
      <button class="btn-buy" id="code-submit">OUVRIR</button>
    </div>
    <p class="gate-error" id="gate-error"></p>
  </div>

  <!-- ============ CONTENU DÉVERROUILLÉ ============ -->
  <div class="secret-content" id="secret-content" hidden>
    <h1 class="page-title">TU AS TROUVÉ ✨</h1>
    <p class="page-sub">bienvenue dans la pièce cachée. ce qui se passe ici reste ici.</p>

    <div class="section-bar"><h2>Maquettes inédites</h2></div>
    <!-- mini-players façon lecteur mp3 années 2000 : LCD vert + chrome -->
    <div class="demo-player" data-demo="{{ 'anomalisa.mp3' | asset_url }}" style="margin-top:12px">
      <button class="dp-play">►</button>
      <div class="dp-lcd">maquette_01</div>
      <div class="dp-progress"><div class="dp-fill"></div></div>
      <span class="dp-time">0:00</span>
    </div>
    <div class="demo-player" data-demo="{{ 'anomalisa.mp3' | asset_url }}">
      <button class="dp-play">►</button>
      <div class="dp-lcd">maquette_02</div>
      <div class="dp-progress"><div class="dp-fill"></div></div>
      <span class="dp-time">0:00</span>
    </div>

    <div class="section-bar"><h2>Behind the scenes du clip</h2></div>
    <div class="crt-frame content-block" style="margin-top:12px">
      <div class="crt-screen">
        <p class="placeholder-msg">🎬 BTS DU CLIP<br>(placeholder : rushs à venir)</p>
      </div>
      <p class="crt-label">CAMÉRA CACHÉE ★ NE PAS DIFFUSER</p>
    </div>
  </div>

</div>
<script>
  /* mini-players des maquettes secrètes (un seul joue à la fois) */
  document.addEventListener('satine:ready', function () {
    var players = document.querySelectorAll('.demo-player');
    var current = null;

    function fmt(t) {
      if (!isFinite(t)) return '0:00';
      var m = Math.floor(t / 60), s = Math.floor(t % 60);
      return m + ':' + (s < 10 ? '0' : '') + s;
    }

    players.forEach(function (p) {
      var audio = new Audio(p.getAttribute('data-demo'));
      var btn = p.querySelector('.dp-play');
      var fill = p.querySelector('.dp-fill');
      var progress = p.querySelector('.dp-progress');
      var time = p.querySelector('.dp-time');

      btn.addEventListener('click', function () {
        if (!audio.paused) { audio.pause(); return; }
        if (current && current !== audio) current.pause();
        current = audio;
        audio.play();
      });
      audio.addEventListener('play', function () { btn.textContent = '❚❚'; });
      audio.addEventListener('pause', function () { btn.textContent = '►'; });
      audio.addEventListener('ended', function () { audio.currentTime = 0; });
      audio.addEventListener('timeupdate', function () {
        if (audio.duration) fill.style.width = (audio.currentTime / audio.duration * 100) + '%';
        time.textContent = fmt(audio.currentTime);
      });
      progress.addEventListener('pointerdown', function (e) {
        var r = progress.getBoundingClientRect();
        if (audio.duration) audio.currentTime = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width)) * audio.duration;
      });
    });
  });
</script>

<script src="{{ 'secret.js' | asset_url }}" defer></script>
