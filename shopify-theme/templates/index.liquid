<script>
  /* boutons VOIR PLUS / VOIR MOINS */
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.see-more').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var target = document.getElementById(btn.getAttribute('data-target'));
        var expanded = target.classList.toggle('expanded');
        btn.textContent = expanded ? 'VOIR MOINS ▲' : 'VOIR PLUS ▼';
      });
    });
  });

  /* player Headspace → iframe YouTube (widget API via postMessage) */
  document.addEventListener('DOMContentLoaded', function () {
    var frame = document.getElementById('clip-frame');
    var pauseBtn = document.getElementById('hs-pause');
    var progress = document.getElementById('hs-progress');
    var fill = document.getElementById('hs-progress-fill');
    var hs = document.querySelector('.headspace');
    var playing = false, currentTime = 0, duration = 0;

    /* --- piste rythmique : anomalisa.mp3 joué en silence, en parallèle du
       clip (même morceau), analysé en WebAudio pour faire pomper les
       enceintes sur les vraies basses --- */
    var beat = new Audio('{{ 'anomalisa.mp3' | asset_url }}');
    beat.preload = 'auto';
    var actx = null, analyser = null, bassData = null, bassDisp = 0;

    function ensureBeatGraph() {
      if (actx) { actx.resume(); return; }
      var C = window.AudioContext || window.webkitAudioContext;
      if (!C) return;
      actx = new C();
      var src = actx.createMediaElementSource(beat);
      analyser = actx.createAnalyser();
      analyser.fftSize = 256;
      bassData = new Uint8Array(analyser.frequencyBinCount);
      var mute = actx.createGain();
      mute.gain.value = 0; /* on n'entend jamais le mp3, seul le clip a le son */
      src.connect(analyser);
      analyser.connect(mute);
      mute.connect(actx.destination);
    }

    function startBeat() {
      ensureBeatGraph();
      beat.play().then(function () {
        if (analyser) hs.classList.add('live');
      }).catch(function () {
        /* autoplay bloqué (lecture lancée depuis l'iframe YouTube) :
           on réessaie au prochain geste utilisateur */
        document.addEventListener('pointerdown', function retry() {
          document.removeEventListener('pointerdown', retry);
          if (playing) startBeat();
        });
      });
    }
    function stopBeat() { beat.pause(); }

    var bassAvg = 0;
    (function bassLoop() {
      requestAnimationFrame(bassLoop);
      if (!analyser || !playing) { hs.style.setProperty('--bass', 0); return; }
      analyser.getByteFrequencyData(bassData);
      var sum = 0, n = 6;
      for (var i = 1; i <= n; i++) sum += bassData[i];
      var raw = sum / n / 255;
      /* seuil adaptatif : on pulse sur ce qui dépasse la moyenne glissante */
      bassAvg = bassAvg * 0.97 + raw * 0.03;
      var level = Math.min(1, Math.max(0, (raw - bassAvg) * 9));
      bassDisp = Math.max(level, bassDisp * 0.82);
      hs.style.setProperty('--bass', bassDisp.toFixed(3));
    })();

    function cmd(func, args) {
      frame.contentWindow.postMessage(JSON.stringify({
        event: 'command', func: func, args: args || []
      }), 'https://www.youtube.com');
    }

    /* poignée de main : demande à YouTube de nous envoyer ses infos */
    function listen() {
      frame.contentWindow.postMessage(JSON.stringify({
        event: 'listening', id: 'satine-hs', channel: 'widget'
      }), 'https://www.youtube.com');
    }
    frame.addEventListener('load', listen);
    listen();

    window.addEventListener('message', function (e) {
      if (e.origin !== 'https://www.youtube.com') return;
      var d;
      try { d = JSON.parse(e.data); } catch (err) { return; }
      if (!d.info) return;
      if (typeof d.info.currentTime === 'number') {
        currentTime = d.info.currentTime;
        /* resynchronise le mp3 rythmique s'il dérive du clip */
        if (playing && !beat.paused && Math.abs(beat.currentTime - currentTime) > 0.35) {
          beat.currentTime = currentTime;
        }
      }
      if (typeof d.info.duration === 'number' && d.info.duration > 0) duration = d.info.duration;
      if (duration > 0) {
        var frac = Math.min(1, currentTime / duration);
        fill.style.width = (frac * 100) + '%';
        progress.style.setProperty('--frac', frac);
      }
      if (typeof d.info.playerState === 'number') {
        playing = d.info.playerState === 1;
        pauseBtn.hidden = !playing;
        hs.classList.toggle('playing', playing);
        if (playing) {
          beat.currentTime = currentTime;
          startBeat();
        } else {
          stopBeat();
        }
      }
    });

    document.getElementById('hs-play').addEventListener('click', function () {
      /* créer le contexte audio dans le clic garantit qu'il démarre débloqué */
      ensureBeatGraph();
      cmd('playVideo');
    });
    pauseBtn.addEventListener('click', function () { cmd('pauseVideo'); });
    document.getElementById('hs-stop').addEventListener('click', function () {
      cmd('stopVideo');
      fill.style.width = '0%';
      progress.style.setProperty('--frac', 0);
      stopBeat();
      beat.currentTime = 0;
    });
    document.getElementById('hs-prev').addEventListener('click', function () {
      cmd('seekTo', [Math.max(0, currentTime - 10), true]);
    });
    document.getElementById('hs-next').addEventListener('click', function () {
      cmd('seekTo', [Math.min(duration || 1e9, currentTime + 10), true]);
    });
    document.getElementById('hs-vis').addEventListener('click', function () {
      window.open('https://www.youtube.com/watch?v=pLmsvejt9RU', '_blank');
    });
    document.getElementById('hs-theme').addEventListener('click', function () {
      var v = document.querySelector('.hs-video');
      if (v.requestFullscreen) v.requestFullscreen();
    });
    progress.addEventListener('click', function (e) {
      if (!duration) return;
      var r = progress.getBoundingClientRect();
      var frac = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
      cmd('seekTo', [frac * duration, true]);
    });
  });
</script>
