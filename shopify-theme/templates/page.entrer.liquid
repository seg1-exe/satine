{% comment %} Porte d'entrée — créer une Page de handle « entrer » avec ce template. Layout dédié sans chrome. {% endcomment %}
{% layout 'intro' %}
<canvas id="stars"></canvas>

  <div id="gate">
    <h1 class="intro-title" data-text="SATINE">SATINE</h1>
    <!-- flèche en SVG : le double clip-path précédent ne se refermait pas
         correctement (le polygone intérieur était recalculé sur une boîte plus
         petite, d'où un contour en deux morceaux). Un seul tracé règle ça. -->
    <button class="enter-arrow" id="enter-btn" aria-label="Entrer sur le site">
      <svg viewBox="0 0 340 112" aria-hidden="true" focusable="false">
        <polygon points="5,27 232,27 232,6 335,56 232,106 232,85 5,85"/>
        <text x="118" y="57">Entrer</text>
      </svg>
    </button>
  </div>

  <div id="popups"></div>

  <noscript>
    <p style="position:fixed;inset:auto 0 40px;text-align:center;z-index:20">
      <a href="index.html?nointro=1" style="color:#ffe600;font-size:22px">Entrer sur le site →</a>
    </p>
  </noscript>

